@model List<DakGharNiryatKendra.Models.DnkCenter>
@{
    ViewData["Title"] = "DNK Kendra Network Directory Management";
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Dak Ghar Niryat Kendra Network Directory</h1>
            <p class="text-muted small mb-0">Manage operational DNK branches, nodal officers, and packaging facilities</p>
        </div>
        <div>
            <button type="button" class="btn btn-dnk-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addKendraModal">
                <i class="bi bi-plus-lg me-1"></i> Add New Kendra Branch
            </button>
        </div>
    </div>

    <!-- Kendras Table -->
    <div class="dnk-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Center Code</th>
                        <th>Kendra Name</th>
                        <th>City & State</th>
                        <th>Pincode</th>
                        <th>Nodal Officer & Contact</th>
                        <th>Operating Hours</th>
                        <th>Facilities</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-danger">@k.CenterCode</td>
                            <td class="fw-bold text-dark">@k.CenterName</td>
                            <td>@k.City, @k.State</td>
                            <td class="font-monospace">@k.Pincode</td>
                            <td>
                                <div>@k.ContactPerson</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@k.Phone | @k.Email</div>
                            </td>
                            <td>@k.OperatingHours</td>
                            <td>
                                @if (k.HasCustomsDesk)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary me-1">Customs</span>
                                }
                                @if (k.HasPackagingFacility)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-dark">Packaging</span>
                                }
                            </td>
                            <td><span class="badge bg-success">Active</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add New Kendra -->
<div class="modal fade" id="addKendraModal" tabindex="-1" aria-labelledby="addKendraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="addKendraModalLabel"><i class="bi bi-building-add me-1"></i> Register New DNK Kendra Branch</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddKendra" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Center Code *</label>
                            <input type="text" name="CenterCode" class="form-control" placeholder="e.g. DNK-PUN-01" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-semibold">Kendra Name *</label>
                            <input type="text" name="CenterName" class="form-control" placeholder="e.g. Pune City HPO Dak Ghar Niryat Kendra" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold">Full Address *</label>
                            <input type="text" name="Address" class="form-control" placeholder="Street / Area name" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">City *</label>
                            <input type="text" name="City" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">State *</label>
                            <input type="text" name="State" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Pincode *</label>
                            <input type="text" name="Pincode" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Nodal Officer Name</label>
                            <input type="text" name="ContactPerson" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Phone / Mobile</label>
                            <input type="text" name="Phone" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dnk-primary btn-sm">Save Kendra Branch</button>
                </div>
            </form>
        </div>
    </div>
</div>
