@model List<DakGharNiryatKendra.Models.User>
@{
    ViewData["Title"] = "Registered MSME Exporters";
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="h4 fw-bold text-dark mb-1">Registered MSME Exporters</h1>
            <p class="text-muted small mb-0">Verified Indian manufacturers, artisans, and e-commerce exporters on the DNK platform</p>
        </div>
    </div>

    <div class="dnk-card p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle small mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Business Entity / Exporter Name</th>
                        <th>IEC Code</th>
                        <th>GSTIN</th>
                        <th>LUT Number</th>
                        <th>Location</th>
                        <th>Contact</th>
                        <th>KYC Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exp in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@(exp.BusinessName ?? exp.FullName)</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@exp.FullName</div>
                            </td>
                            <td><span class="font-monospace fw-bold text-danger">@exp.IecNumber</span></td>
                            <td><span class="font-monospace">@exp.Gstin</span></td>
                            <td><span class="font-monospace text-primary">@exp.LutNumber</span></td>
                            <td>@exp.City, @exp.State - @exp.Pincode</td>
                            <td>
                                <div>@exp.PhoneNumber</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@exp.Email</div>
                            </td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                    <i class="bi bi-patch-check-fill me-1"></i> Verified
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
