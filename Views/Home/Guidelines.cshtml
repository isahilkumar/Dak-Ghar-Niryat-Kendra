@{
    ViewData["Title"] = "Export Compliance & Customs Guidelines";
}

<div class="container px-lg-4 py-5">
    <div class="text-center mb-5">
        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 rounded-pill fw-bold">Statutory Compliance</span>
        <h1 class="display-6 fw-bold text-dark mt-2">Dak Ghar Export & Customs Guidelines</h1>
        <p class="text-muted mx-auto" style="max-width: 680px;">
            Comprehensive guide to exporting goods via India Post under the Postal Export Rules 2018, Section 84 of Customs Act 1962, and Foreign Trade Policy.
        </p>
    </div>

    <div class="row g-4">
        <!-- 1. PBE-I vs PBE-II Table -->
        <div class="col-lg-6">
            <div class="dnk-card h-100">
                <h3 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-text text-danger"></i> Postal Bill of Export (PBE) Classification
                </h3>
                <div class="table-responsive">
                    <table class="table table-bordered table-sm small align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Category</th>
                                <th>PBE-I (E-Commerce)</th>
                                <th>PBE-II (Commercial/Sample)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-semibold">Export Purpose</td>
                                <td>Direct retail sale through e-commerce portal or website</td>
                                <td>B2B export, non-e-commerce trade, samples, gifts</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Value Threshold</td>
                                <td>FOB value up to ₹ 10,00,000 per consignment</td>
                                <td>No statutory monetary limit (as per IEC license)</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">GST / LUT</td>
                                <td>Zero-rated under Letter of Undertaking (LUT)</td>
                                <td>LUT or payment of IGST with refund claim</td>
                            </tr>
                            <tr>
                                <td class="fw-semibold">Incentive Support</td>
                                <td>Eligible for RoDTEP, RoSCTL & duty drawback</td>
                                <td>Eligible for all standard FTP export benefits</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 2. Mandatory Documents Checklist -->
        <div class="col-lg-6">
            <div class="dnk-card h-100">
                <h3 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                    <i class="bi bi-card-checklist text-success"></i> Mandatory Export Checklist
                </h3>
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <div><strong>Import Export Code (IEC):</strong> 10-digit PAN-based IEC issued by Directorate General of Foreign Trade (DGFT).</div>
                    </li>
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <div><strong>GSTIN & LUT Number:</strong> Valid GST registration and active Letter of Undertaking filed on the GST portal for tax exemption.</div>
                    </li>
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <div><strong>Authorized Dealer (AD) Code:</strong> 14-digit bank AD code registered with ICEGATE for export realization monitoring (EDPMS).</div>
                    </li>
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle-fill text-success mt-1"></i>
                        <div><strong>Harmonized System (HS) Code:</strong> 6 to 8-digit international commodity classification code matching export items.</div>
                    </li>
                </ul>
            </div>
        </div>

        <!-- 3. Prohibited & Restricted Goods Notice -->
        <div class="col-12">
            <div class="alert alert-danger border-0 shadow-sm p-4 rounded-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-shield-slash-fill fs-4 text-danger"></i>
                    <h4 class="h6 fw-bold mb-0 text-danger">Prohibited Articles in International Postal Mail (UPU Regulations)</h4>
                </div>
                <p class="small mb-3">
                    The following items are strictly prohibited in international postal mail under the Universal Postal Union (UPU) convention and Indian Customs Act 1962:
                </p>
                <div class="row g-2 small">
                    <div class="col-md-4">
                        <i class="bi bi-x-circle text-danger me-1"></i> Explosives, flammable liquids, ammunition
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-x-circle text-danger me-1"></i> Narcotic drugs & psychotropic substances
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-x-circle text-danger me-1"></i> Currency notes, counterfeit coins, bullion
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-x-circle text-danger me-1"></i> Live animals, endangered wildlife & CITES items
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-x-circle text-danger me-1"></i> Antique items & archaeological relics &gt; 100 yrs
                    </div>
                    <div class="col-md-4">
                        <i class="bi bi-x-circle text-danger me-1"></i> Corrosive chemicals, radioactive materials
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
