<!-- 8. FREQUENTLY ASKED QUESTIONS (FAQ)                                    -->
<!-- ═══════════════════════════════════════════════════════════════════════ -->
<section class="py-5 bg-light border-bottom">
    <div class="container px-lg-4" style="max-width: 900px;">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="hero-pro-badge d-inline-flex mb-2" style="font-size:0.75rem; background: #f1f5f9; color: #475569; border-color: #cbd5e1;">
                <i class="bi bi-question-circle me-1 text-secondary"></i> <span data-i18n="faq_badge">Help &amp; Guidelines</span>
            </span>
            <h2 class="fw-bold text-dark mt-2" style="font-size:2.2rem;" data-i18n="faq_title">Frequently Asked Questions</h2>
            <p class="text-muted mx-auto" data-i18n="faq_desc">
                Everything you need to know about exporting through the Dak Ghar Niryat Kendra portal.
            </p>
        </div>

        <div class="accordion accordion-dnk reveal-on-scroll" id="faqAccordion">
            <!-- FAQ 1 -->
            <div class="accordion-item mb-3">
                <h2 class="accordion-header" id="faqHeading1">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse1" aria-expanded="true" aria-controls="faqCollapse1" data-i18n="faq1_q">
                        What documents do I need to register as an MSME Exporter on DNK?
                    </button>
                </h2>
                <div id="faqCollapse1" class="accordion-collapse collapse show" aria-labelledby="faqHeading1" data-bs-parent="#faqAccordion">
                    <div class="accordion-body" data-i18n="faq1_a">
                        To register, you need: 1) Valid DGFT Import-Export Code (IEC), 2) GSTIN registration, 3) Active Letter of Undertaking (LUT RFD-11) for zero-rated IGST export, and 4) Authorized Dealer (AD) Code registered with Customs.
                    </div>
                </div>
            </div>

            <!-- FAQ 2 -->
            <div class="accordion-item mb-3">
                <h2 class="accordion-header" id="faqHeading2">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse2" aria-expanded="false" aria-controls="faqCollapse2" data-i18n="faq2_q">
                        What is an electronic Postal Bill of Export (e-PBE)?
                    </button>
                </h2>
                <div id="faqCollapse2" class="accordion-collapse collapse" aria-labelledby="faqHeading2" data-bs-parent="#faqAccordion">
                    <div class="accordion-body" data-i18n="faq2_a">
                        An e-PBE is a paperless commercial export declaration governed by Section 84 of the Customs Act, 1962. It replaces traditional manual shipping bills and transmits consignment data directly to the Foreign Post Office (FPO) customs system.
                    </div>
                </div>
            </div>

            <!-- FAQ 3 -->
            <div class="accordion-item mb-3">
                <h2 class="accordion-header" id="faqHeading3">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse3" aria-expanded="false" aria-controls="faqCollapse3" data-i18n="faq3_q">
                        How does Doorstep Pickup work for export parcels?
                    </button>
                </h2>
                <div id="faqCollapse3" class="accordion-collapse collapse" aria-labelledby="faqHeading3" data-bs-parent="#faqAccordion">
                    <div class="accordion-body" data-i18n="faq3_a">
                        Once your e-PBE is filed and S10 barcode printed, you can request pickup from your Exporter Desk. Your assigned beat postman receives the collection task and picks up the parcel directly from your premises with digital barcode scanning.
                    </div>
                </div>
            </div>

            <!-- FAQ 4 -->
            <div class="accordion-item">
                <h2 class="accordion-header" id="faqHeading4">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse4" aria-expanded="false" aria-controls="faqCollapse4" data-i18n="faq4_q">
                        Can I claim RoDTEP and Duty Drawback on postal exports?
                    </button>
                </h2>
                <div id="faqCollapse4" class="accordion-collapse collapse" aria-labelledby="faqHeading4" data-bs-parent="#faqAccordion">
                    <div class="accordion-body" data-i18n="faq4_a">
                        Yes. Consignments exported via e-PBE are fully eligible for RoDTEP (Remission of Duties and Taxes on Exported Products) and duty drawback benefits directly credited to your authorized bank account.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

