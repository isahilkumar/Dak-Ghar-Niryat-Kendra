@{
    ViewData["Title"] = "Dak Ghar Niryat Kendra | India Post Export Portal";
    var featuredCenters = ViewBag.FeaturedCenters as List<DnkCenter> ?? new List<DnkCenter>();
    var topDestinations = ViewBag.TopDestinations as IEnumerable<dynamic> ?? new List<dynamic>();
    var popularHsCodes = ViewBag.PopularHsCodes as List<HsCodeDirectory> ?? new List<HsCodeDirectory>();
    decimal totalVal = 0m;
    if (ViewBag.TotalValueINR != null)
    {
        decimal.TryParse(ViewBag.TotalValueINR.ToString(), out totalVal);
    }
}

