@section Scripts {
<script>
    function switchHeroTab(tabName) {
        const trackTab = document.getElementById("track-tab");
        const rateTab = document.getElementById("rate-tab");
        const tabTrack = document.getElementById("tab-track");
        const tabRate = document.getElementById("tab-rate");

        if (tabName === 'track') {
            trackTab?.classList.add("active");
            rateTab?.classList.remove("active");
            if (tabTrack) tabTrack.style.display = "block";
            if (tabRate) tabRate.style.display = "none";
            tabTrack?.classList.add("show", "active");
            tabRate?.classList.remove("show", "active");
        } else {
            rateTab?.classList.add("active");
            trackTab?.classList.remove("active");
            if (tabRate) tabRate.style.display = "block";
            if (tabTrack) tabTrack.style.display = "none";
            tabRate?.classList.add("show", "active");
            tabTrack?.classList.remove("show", "active");
            calculateQuickRates();
        }
    }

    function fillTrack(num) {
        const input = document.getElementById("simpleTrackingInput");
        if (input) {
            input.value = num;
            input.focus();
        }
    }

    const simpleRates = {
        "IN": { ems: 250, parcel: 180 },
        "US": { ems: 1500, parcel: 1100 },
        "GB": { ems: 1400, parcel: 1050 },
        "AE": { ems: 900, parcel: 700 },
        "DE": { ems: 1400, parcel: 1050 },
        "AU": { ems: 1600, parcel: 1200 },
        "CA": { ems: 1550, parcel: 1150 },
        "SG": { ems: 1100, parcel: 800 },
        "OTH": { ems: 1800, parcel: 1350 }
    };

    function calculateQuickRates() {
        const country = document.getElementById("quickCountry")?.value || "US";
        const weight = parseFloat(document.getElementById("quickWeight")?.value || "1.0");
        const base = simpleRates[country] || simpleRates["US"];

        const weightMultiplier = Math.max(1, weight);
        const emsTotal = base.ems * weightMultiplier * 1.18;
        const parcelTotal = base.parcel * weightMultiplier * 1.18;

        const emsEl = document.getElementById("quickEmsPrice");
        const parcelEl = document.getElementById("quickParcelPrice");

        if (emsEl) emsEl.textContent = "₹ " + emsTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        if (parcelEl) parcelEl.textContent = "₹ " + parcelTotal.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
</script>
}
