@{
    ViewData["Title"] = "About Dak Ghar Niryat Kendra Initiative";
}

<div class="container px-lg-4 py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 rounded-pill fw-bold">Department of Posts</span>
            <h1 class="display-6 fw-bold text-dark mt-2">Empowering India's Micro & Rural Exporters</h1>
            <p class="text-muted leading-relaxed">
                The <strong>Dak Ghar Niryat Kendra (DNK)</strong> initiative by India Post, in collaboration with the Central Board of Indirect Taxes & Customs (CBIC) and Directorate General of Foreign Trade (DGFT), transforms designated post offices across every district into comprehensive export facilitation hubs.
            </p>
            <p class="text-muted leading-relaxed">
                Historically, small artisans, weavers, and rural entrepreneurs faced immense friction in accessing customs ports and foreign trade documentation. DNK brings paperless electronic customs clearance, packaging support, and international courier capabilities right to their doorstep.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="p-4 bg-white rounded-4 border shadow-sm">
                <h3 class="h5 fw-bold text-dark mb-3 border-bottom pb-2">Core Strategic Objectives</h3>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3"><i class="bi bi-globe fs-4"></i></div>
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Global Market Access for Artisans</h4>
                        <p class="text-muted small mb-0">Direct cross-border mail connectivity to 210+ member countries of the Universal Postal Union (UPU).</p>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="p-2 bg-success bg-opacity-10 text-success rounded-3"><i class="bi bi-file-earmark-check fs-4"></i></div>
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Paperless Postal Bill of Export</h4>
                        <p class="text-muted small mb-0">Seamless digital integration with Indian Customs ICEGATE and RBI EDPMS systems for automated export compliance.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start gap-3">
                    <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3"><i class="bi bi-truck fs-4"></i></div>
                    <div>
                        <h4 class="h6 fw-bold text-dark mb-1">Last-Mile Doorstep Induction</h4>
                        <p class="text-muted small mb-0">Integration with the vast postal delivery network covering 1.55 lakh+ post offices across the nation.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
