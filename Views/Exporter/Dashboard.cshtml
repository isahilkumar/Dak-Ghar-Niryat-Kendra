@model DakGharNiryatKendra.Models.ViewModels.ExporterDashboardViewModel
@{
    ViewData["Title"] = "MSME Exporter Dashboard";
    var exp = Model.Exporter;
}

<div class="container-fluid px-lg-4 py-4">
    <!-- Top Welcome Banner -->
    <div class="p-4 rounded-4 bg-white border shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="emblem-box" style="width: 54px; height: 54px; font-size: 1.5rem;">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-bold text-dark mb-0">@(exp.BusinessName ?? exp.FullName)</h1>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">
                            <i class="bi bi-shield-check me-1"></i> IEC Verified
                        </span>
                    </div>
                    <div class="text-muted small mt-1">
                        <strong>IEC:</strong> <span class="font-monospace text-dark">@exp.IecNumber</span> | 
                        <strong>GSTIN:</strong> <span class="font-monospace text-dark">@exp.Gstin</span> | 
                        <strong>LUT:</strong> <span class="font-monospace text-dark">@exp.LutNumber</span> | 
                        <strong>Location:</strong> @exp.City, @exp.State
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Exporter" asp-action="Book" class="btn btn-dnk-primary">
                    <i class="bi bi-plus-circle me-1"></i> Book New Export (e-PBE)
                </a>
                <a asp-controller="Home" asp-action="Calculator" class="btn btn-outline-secondary">
                    <i class="bi bi-calculator"></i> Rates
                </a>
            </div>
        </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="dnk-card p-3 h-100">
                <div class="text-muted small fw-semibold text-uppercase">Total Export Articles</div>
                <div class="fs-3 fw-bold text-dark brand-font mt-1">@Model.TotalShipments</div>
                <div class="text-muted small mt-1"><i class="bi bi-box-seam me-1 text-danger"></i>Lifetime Total</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="dnk-card p-3 h-100">
                <div class="text-muted small fw-semibold text-uppercase">Active Shipments</div>
                <div class="fs-3 fw-bold text-primary brand-font mt-1">@Model.ActiveShipments</div>
                <div class="text-muted small mt-1"><i class="bi bi-arrow-repeat me-1 text-primary"></i>In Pipeline</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="dnk-card p-3 h-100">
                <div class="text-muted small fw-semibold text-uppercase">In Flight / Transit</div>
                <div class="fs-3 fw-bold text-warning brand-font mt-1">@Model.InTransitShipments</div>
                <div class="text-muted small mt-1"><i class="bi bi-airplane me-1 text-warning"></i>International Air</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="dnk-card p-3 h-100">
                <div class="text-muted small fw-semibold text-uppercase">Customs Cleared</div>
                <div class="fs-3 fw-bold text-success brand-font mt-1">@Model.CustomsClearedShipments</div>
                <div class="text-muted small mt-1"><i class="bi bi-check-circle me-1 text-success"></i>Out of Charge</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="dnk-card p-3 h-100">
                <div class="text-muted small fw-semibold text-uppercase">Delivered Abroad</div>
                <div class="fs-3 fw-bold text-emerald brand-font mt-1">@Model.DeliveredShipments</div>
                <div class="text-muted small mt-1"><i class="bi bi-house-check me-1 text-success"></i>Confirmed POD</div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl-2">
            <div class="dnk-card p-3 h-100 border-start border-4 border-danger">
                <div class="text-muted small fw-semibold text-uppercase">Export Turnover</div>
                <div class="fs-3 fw-bold text-danger brand-font mt-1">₹ @Model.TotalExportValueINR.ToString("N0")</div>
                <div class="text-muted small mt-1">($ @Model.TotalExportValueUSD.ToString("N0") USD)</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Recent Consignments Table -->
        <div class="col-lg-8">
            <div class="dnk-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 fw-bold text-dark mb-0">Recent Export Bookings & PBE Status</h2>
                    <a asp-controller="Exporter" asp-action="Shipments" class="btn btn-sm btn-outline-danger">View All Shipments</a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Article / S10 Barcode</th>
                                <th>PBE Number</th>
                                <th>Destination</th>
                                <th>Value (INR)</th>
                                <th>Customs / Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentConsignments.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">
                                        No export consignments booked yet. <a asp-controller="Exporter" asp-action="Book">Create your first booking</a>.
                                    </td>
                                </tr>
                            }
                            @foreach (var item in Model.RecentConsignments)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Exporter" asp-action="Details" asp-route-id="@item.Id" class="fw-bold font-monospace text-danger text-decoration-none">
                                            @item.TrackingNumber
                                        </a>
                                        <div class="text-muted" style="font-size: 0.75rem;">@item.ServiceType.ToString().Replace('_', ' ')</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border font-monospace">@item.PbeNumber</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.RecipientCountry</span>
                                        <div class="text-muted" style="font-size: 0.75rem;">@item.RecipientCity</div>
                                    </td>
                                    <td class="fw-bold">
                                        ₹ @item.DeclaredValueINR.ToString("N2")
                                    </td>
                                    <td>
                                        <span class="badge-status @(item.Status == DakGharNiryatKendra.Models.ConsignmentStatus.Delivered ? "badge-status-delivered" : item.Status == DakGharNiryatKendra.Models.ConsignmentStatus.CustomsHold ? "badge-status-hold" : "badge-status-transit")">
                                            @item.Status.ToString()
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="Exporter" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View details & milestones"><i class="bi bi-eye"></i></a>
                                            <a asp-controller="Exporter" asp-action="PrintPbe" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Print PBE Form" target="_blank"><i class="bi bi-file-earmark-text"></i></a>
                                            <a asp-controller="Exporter" asp-action="PrintLabel" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Print Barcode Shipping Label" target="_blank"><i class="bi bi-upc"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Doorstep Pickups & Quick Tools -->
        <div class="col-lg-4">
            <!-- Active Pickups Card -->
            <div class="dnk-card p-4 mb-4">
                <h3 class="h6 fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-truck text-warning fs-5"></i> Doorstep Pickup Status
                </h3>

                @if (Model.PendingPickups.Count == 0)
                {
                    <div class="p-3 bg-light rounded text-center small text-muted">
                        No active pickup requests. You can schedule doorstep collection during booking.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var p in Model.PendingPickups)
                        {
                            <div class="p-3 bg-light rounded-3 border small">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="badge bg-warning text-dark font-monospace">Article: @p.ExportConsignment?.TrackingNumber</span>
                                    <span class="badge bg-secondary">@p.Status</span>
                                </div>
                                <div class="text-dark fw-semibold mb-1">
                                    Scheduled: @p.ScheduledDate.ToString("dd MMM yyyy") (@p.TimeSlot.ToString().Replace('_', ' '))
                                </div>
                                @if (!string.IsNullOrEmpty(p.AssignedPostmanName))
                                {
                                    <div class="text-muted"><i class="bi bi-person me-1"></i>Postman: <strong>@p.AssignedPostmanName</strong> (@p.AssignedPostmanPhone)</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Quick Guidelines Checklist -->
            <div class="p-4 rounded-4 bg-light border">
                <h4 class="h6 fw-bold text-dark mb-2"><i class="bi bi-lightbulb text-warning me-1"></i>MSME Export Tips</h4>
                <ul class="text-muted small ps-3 mb-0">
                    <li class="mb-2">Affix the <strong>S10 Barcode Label</strong> and <strong>CN22/23 customs voucher</strong> on the top face of the box.</li>
                    <li class="mb-2">Ensure Commercial Invoice copy is inserted inside the transparent document pouch.</li>
                    <li>Claim zero-rated IGST by providing your active <strong>LUT number</strong> during e-PBE filing.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
