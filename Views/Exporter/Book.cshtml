@model DakGharNiryatKendra.Models.ViewModels.BookConsignmentViewModel
@{
    ViewData["Title"] = "Book Export Consignment & File Electronic PBE";
    var centers = ViewBag.Centers as List<DnkCenter> ?? new List<DnkCenter>();
    var countries = ViewBag.Countries as IEnumerable<dynamic> ?? new List<dynamic>();
    var hsCodes = ViewBag.HsCodes as List<HsCodeDirectory> ?? new List<HsCodeDirectory>();
    var exporter = ViewBag.Exporter as User;
}

<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 rounded-pill fw-bold">Electronic Customs Filing</span>
            <h1 class="h3 fw-bold text-dark mt-1 mb-0">Book Export Consignment & File e-PBE</h1>
        </div>
        <div>
            <a asp-controller="Exporter" asp-action="Shipments" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Shipments
            </a>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <h6 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Please correct the validation errors:</h6>
            <div asp-validation-summary="All" class="small mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <form asp-controller="Exporter" asp-action="Book" method="post" id="bookingForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="itemsJson" id="itemsJsonInput" value="" />

        <div class="row g-4">
            <!-- Left Side: Wizard Sections -->
            <div class="col-lg-8">
                <!-- Section 1: Service & Induction Post Office -->
                <div class="dnk-card p-4 mb-4">
                    <h2 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <span class="badge bg-danger rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">1</span>
                        Postal Service & Induction Kendra
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Select International Postal Service *</label>
                            <select asp-for="ServiceType" class="form-select" id="serviceTypeSelect">
                                <option value="EMS_SpeedPost">International EMS (Speed Post) - Priority Fast Track</option>
                                <option value="InternationalAirParcel">International Air Parcel - Economical Bulk</option>
                                <option value="ITPS_TrackedPacket">ITPS (Tracked Packet) - E-Commerce under 2 Kg</option>
                                <option value="RegisteredAirMail">International Registered Air Mail</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Postal Bill of Export (PBE) Form *</label>
                            <select asp-for="PbeType" class="form-select">
                                <option value="PBE_I">PBE-I (For E-Commerce / Retail Web Export)</option>
                                <option value="PBE_II">PBE-II (For Commercial Goods / Samples / B2B)</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-dark">Induction Dak Ghar Niryat Kendra *</label>
                            <select asp-for="DnkCenterId" class="form-select">
                                @foreach (var center in centers)
                                {
                                    <option value="@center.Id">
                                        @center.CenterCode - @center.CenterName (@center.City, @center.State - @center.Pincode)
                                    </option>
                                }
                            </select>
                            <div class="form-text small">Select the post office where you will drop off the parcel or from where pickup will be assigned.</div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Consignee / Recipient Details -->
                <div class="dnk-card p-4 mb-4">
                    <h2 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <span class="badge bg-danger rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">2</span>
                        Consignee (Recipient Overseas) Information
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Recipient Full Name *</label>
                            <input asp-for="RecipientName" class="form-control" placeholder="e.g. Johnathan Miller" required />
                            <span asp-validation-for="RecipientName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Recipient Company / Store Name (Optional)</label>
                            <input asp-for="RecipientCompany" class="form-control" placeholder="e.g. Global Crafts Imports LLC" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Recipient Email Address *</label>
                            <input asp-for="RecipientEmail" type="email" class="form-control" placeholder="john@example.com" required />
                            <span asp-validation-for="RecipientEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Recipient Phone / Mobile *</label>
                            <input asp-for="RecipientPhone" class="form-control" placeholder="+1 555 123 4567" required />
                            <span asp-validation-for="RecipientPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small text-dark">Street Address *</label>
                            <input asp-for="RecipientAddress" class="form-control" placeholder="Suite / Flat / House No, Street name" required />
                            <span asp-validation-for="RecipientAddress" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">City *</label>
                            <input asp-for="RecipientCity" class="form-control" placeholder="e.g. New York, London..." required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">State / Province / Region</label>
                            <input asp-for="RecipientState" class="form-control" placeholder="e.g. NY, California..." />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Postal / ZIP Code *</label>
                            <input asp-for="RecipientPostalCode" class="form-control mono-font" placeholder="e.g. 10001" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-dark">Destination Country *</label>
                            <select asp-for="DestinationCountryCode" class="form-select" id="destCountrySelect" onchange="document.getElementById('recipientCountryInput').value = this.options[this.selectedIndex].text.split('(')[0].trim();">
                                @foreach (var c in countries)
                                {
                                    <option value="@c.CountryCode">@c.CountryName (@c.CountryCode)</option>
                                }
                            </select>
                            <input type="hidden" asp-for="RecipientCountry" id="recipientCountryInput" value="United States" />
                        </div>
                    </div>
                </div>

                <!-- Section 3: Package Dimensions & Weight -->
                <div class="dnk-card p-4 mb-4">
                    <h2 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <span class="badge bg-danger rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">3</span>
                        Package Dimensions & Weighment
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">Gross Weight (Kg) *</label>
                            <input asp-for="ActualWeightKg" type="number" step="0.01" class="form-control fw-bold" id="actualWeightInput" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">Length (cm) *</label>
                            <input asp-for="LengthCm" type="number" step="0.5" class="form-control" id="lengthInput" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">Width (cm) *</label>
                            <input asp-for="WidthCm" type="number" step="0.5" class="form-control" id="widthInput" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label fw-semibold small text-dark">Height (cm) *</label>
                            <input asp-for="HeightCm" type="number" step="0.5" class="form-control" id="heightInput" required />
                        </div>
                    </div>
                </div>

                <!-- Section 4: Export Line Items & HS Code Selection -->
                <div class="dnk-card p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h2 class="h5 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                            <span class="badge bg-danger rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">4</span>
                            Export Goods Description & Harmonized System (HS) Codes
                        </h2>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="addItemRowBtn">
                            <i class="bi bi-plus-lg"></i> Add Item
                        </button>
                    </div>

                    <!-- Quick HS Code Tag Helpers for MSMEs -->
                    <div class="p-2 bg-light rounded-3 border mb-3 small">
                        <span class="text-muted fw-semibold me-2"><i class="bi bi-tag text-danger"></i>Popular Export HS Codes (Click to copy):</span>
                        <div class="d-inline-flex flex-wrap gap-1 mt-1">
                            <span class="badge bg-white text-dark border pointer" onclick="navigator.clipboard.writeText('6204.42');" title="Click to copy">6204.42 (Cotton Handloom Dresses)</span>
                            <span class="badge bg-white text-dark border pointer" onclick="navigator.clipboard.writeText('7419.80');" title="Click to copy">7419.80 (Brass Artware)</span>
                            <span class="badge bg-white text-dark border pointer" onclick="navigator.clipboard.writeText('0908.31');" title="Click to copy">0908.31 (Cardamom / Spices)</span>
                            <span class="badge bg-white text-dark border pointer" onclick="navigator.clipboard.writeText('5701.10');" title="Click to copy">5701.10 (Silk Carpets / Pashmina)</span>
                            <span class="badge bg-white text-dark border pointer" onclick="navigator.clipboard.writeText('9503.00');" title="Click to copy">9503.00 (Wooden Toys)</span>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle small mb-2" id="bookingItemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Item Description *</th>
                                    <th>HS Code (6-8 Digits) *</th>
                                    <th>Qty</th>
                                    <th>Unit</th>
                                    <th>Unit Price (INR)</th>
                                    <th>Net Wt (Kg)</th>
                                    <th class="text-end">Total (INR)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="bookingItemsBody">
                                <tr>
                                    <td>
                                        <input type="text" class="form-control form-control-sm item-desc" placeholder="e.g. Handcrafted Brass Vase" value="Handcrafted Ornamental Brass Artware" required />
                                    </td>
                                    <td style="width: 130px;">
                                        <input type="text" class="form-control form-control-sm item-hs mono-font" placeholder="7419.80" value="7419.80" required />
                                    </td>
                                    <td style="width: 80px;">
                                        <input type="number" class="form-control form-control-sm item-qty" value="1" min="1" />
                                    </td>
                                    <td style="width: 90px;">
                                        <select class="form-select form-select-sm item-uom">
                                            <option value="PCS" selected>PCS</option>
                                            <option value="KGS">KGS</option>
                                            <option value="SET">SET</option>
                                            <option value="BOX">BOX</option>
                                        </select>
                                    </td>
                                    <td style="width: 130px;">
                                        <input type="number" step="0.01" class="form-control form-control-sm item-unitprice" value="8650" min="1" />
                                    </td>
                                    <td style="width: 90px;">
                                        <input type="number" step="0.01" class="form-control form-control-sm item-weight" value="0.50" min="0.01" />
                                    </td>
                                    <td class="text-end fw-bold item-total text-dark">₹ 8,650.00</td>
                                    <td class="text-center" style="width: 40px;">
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-item-btn"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Section 5: Customs & Invoicing Information -->
                <div class="dnk-card p-4 mb-4">
                    <h2 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <span class="badge bg-danger rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">5</span>
                        Commercial Invoice & Zero-Rated GST Declaration
                    </h2>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Nature of Export *</label>
                            <select asp-for="NatureOfExport" class="form-select">
                                <option value="Sale of Goods (Commercial)">Sale of Goods (Commercial)</option>
                                <option value="E-Commerce Retail Sale">E-Commerce Retail Sale</option>
                                <option value="Commercial Sample">Commercial Sample</option>
                                <option value="Gift / Personal Article">Gift / Personal Article</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Invoice Number</label>
                            <input asp-for="InvoiceNumber" class="form-control font-monospace" placeholder="INV-2026-001" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Invoice Date</label>
                            <input asp-for="InvoiceDate" type="date" class="form-control" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Letter of Undertaking (LUT)</label>
                            <input asp-for="LutNumber" class="form-control font-monospace" placeholder="e.g. AD080326001923K" />
                            <div class="form-text small">LUT allows zero-rated IGST export without paying tax upfront.</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Invoice Currency</label>
                            <select asp-for="CurrencyCode" class="form-select">
                                <option value="USD" selected>USD - US Dollar</option>
                                <option value="EUR">EUR - Euro</option>
                                <option value="GBP">GBP - British Pound</option>
                                <option value="AED">AED - UAE Dirham</option>
                                <option value="INR">INR - Indian Rupee</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold small text-dark">Total Declared Value (INR) *</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">₹</span>
                                <input asp-for="DeclaredValueINR" type="number" step="0.01" class="form-control fw-bold" id="declaredValueINRInput" required />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 6: Doorstep Pickup -->
                <div class="dnk-card p-4 mb-4">
                    <h2 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark rounded-circle p-2" style="width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center;">6</span>
                        Doorstep Postman Pickup (Optional)
                    </h2>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="RequestPickup" class="form-check-input" type="checkbox" id="requestPickupSwitch" onchange="document.getElementById('pickupDetailsBox').classList.toggle('d-none', !this.checked)" />
                        <label class="form-check-label fw-bold text-dark" for="requestPickupSwitch">
                            Request Speed Post Postman to pick up parcel from my registered business premises
                        </label>
                    </div>

                    <div id="pickupDetailsBox" class="p-3 bg-light rounded-3 border d-none">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-dark">Preferred Pickup Date</label>
                                <input asp-for="ScheduledPickupDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small text-dark">Preferred Time Window</label>
                                <select asp-for="PickupTimeSlot" class="form-select">
                                    <option value="Morning_09_12">Morning (09:00 AM - 12:00 PM)</option>
                                    <option value="Afternoon_12_16">Afternoon (12:00 PM - 04:00 PM)</option>
                                    <option value="Evening_16_19">Evening (04:00 PM - 07:00 PM)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold small text-dark">Special Packaging / Pickup Instructions</label>
                                <input asp-for="PickupSpecialInstructions" class="form-control" placeholder="e.g. Fragile ceramic item, gate entry code, etc." />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Exporter Profile & Submission Summary -->
            <div class="col-lg-4">
                <div class="dnk-card sticky-top" style="top: 100px;">
                    <h3 class="h5 fw-bold text-dark mb-3 pb-2 border-bottom">Exporter Legal Profile</h3>

                    <div class="p-3 bg-light rounded-3 border mb-3 small">
                        <div class="fw-bold text-dark mb-1">@(exporter?.BusinessName ?? "MSME Enterprise")</div>
                        <div class="text-muted mb-2"><i class="bi bi-geo-alt text-danger me-1"></i>@(exporter?.Address), @(exporter?.City) - @(exporter?.Pincode)</div>
                        <div class="mb-1"><strong>IEC:</strong> <span class="font-monospace text-dark">@(exporter?.IecNumber)</span></div>
                        <div class="mb-1"><strong>GSTIN:</strong> <span class="font-monospace text-dark">@(exporter?.Gstin)</span></div>
                        <div><strong>AD Code:</strong> <span class="font-monospace text-dark">@(exporter?.AdCode)</span></div>
                    </div>

                    <!-- Statutory Self-Declaration Checkbox -->
                    <div class="form-check mb-3 small">
                        <input class="form-check-input" type="checkbox" id="statutoryDeclarationCheck" required checked />
                        <label class="form-check-label text-muted" for="statutoryDeclarationCheck">
                            I declare that the information furnished in this electronic Postal Bill of Export is true and correct, and the goods do not contain any prohibited articles.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-dnk-primary btn-lg w-100 py-3 shadow">
                        <i class="bi bi-file-earmark-check fs-5 me-1"></i> Generate e-PBE & Book
                    </button>

                    <div class="text-muted small text-center mt-3">
                        <i class="bi bi-shield-check text-success me-1"></i> 100% Paperless &bull; UPU S10 Barcode Generated Instantly
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
